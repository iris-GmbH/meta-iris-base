+static int adi_cap_reqbufs(struct file *file, void *priv,
+			   struct v4l2_requestbuffers *reqbufs)
+{
+	struct adi_cap_device *adi_cap_dev = video_drvdata(file);
+	int ret;
+
+	v4l2_dbg(ADI_CAP_LOG_DETAIL, debug, &adi_cap_dev->v4l2_dev,
+		 "reqbufs request: count %u type %u memory %u io_modes 0x%x\n",
+		 reqbufs->count, reqbufs->type, reqbufs->memory,
+		 adi_cap_dev->buffer_queue.io_modes);
+
+	ret = vb2_ioctl_reqbufs(file, priv, reqbufs);
+	if (ret) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+			 "reqbufs failed: %d count %u memory %u\n",
+			 ret, reqbufs->count, reqbufs->memory);
+		return ret;
+	}
+
+	v4l2_dbg(ADI_CAP_LOG_DETAIL, debug, &adi_cap_dev->v4l2_dev,
+		 "reqbufs result: count %u capabilities 0x%x\n",
+		 reqbufs->count, reqbufs->capabilities);
+
+	return 0;
+}
