From 5894143febe0c701c4c9e2ab61c2736e87ae385d Mon Sep 17 00:00:00 2001
From: Ian Dannapel <ian.dannapel@iris-sensing.com>
Date: Fri, 5 Jun 2026 09:19:24 +0200
Subject: [PATCH 10/29] media: adi: add SC5xx video capture driver

Add a V4L2 capture bridge for ADI SC5xx PPI/EPPI inputs.
The driver supports vb2 DMA-contig queues, DMABUF capture, one-shot operation, subdev format negotiation, stream diagnostics and the Gen6 center-out DMA layout.

Signed-off-by: Ian Dannapel <ian.dannapel@iris-sensing.com>
---
 drivers/media/platform/adi/Kconfig       |   12 +
 drivers/media/platform/adi/Makefile      |    1 +
 drivers/media/platform/adi/adi_capture.c | 1950 ++++++++++++++++++++++
 include/media/adi/adi_capture.h          |   58 +
 4 files changed, 2021 insertions(+)
 create mode 100644 drivers/media/platform/adi/adi_capture.c
 create mode 100644 include/media/adi/adi_capture.h

diff --git a/drivers/media/platform/adi/Kconfig b/drivers/media/platform/adi/Kconfig
index 069bfa992efe5..2a172142b90eb 100644
--- a/drivers/media/platform/adi/Kconfig
+++ b/drivers/media/platform/adi/Kconfig
@@ -1,3 +1,15 @@
+config VIDEO_ADI_CAPTURE
+	tristate "ADI SC5XX Video Capture Driver"
+	depends on VIDEO_V4L2 && (ARCH_SC58X || ARCH_SC57X) && I2C
+	depends on HAS_DMA
+	select VIDEOBUF2_DMA_CONTIG
+	help
+	  V4L2 bridge driver for ADI SC5XX video capture devices.
+	  Choose PPI or EPPI as its interface.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called adi_capture.
+
 config VIDEO_ADI_PPI
 	tristate
 	depends on VIDEO_ADI_CAPTURE
