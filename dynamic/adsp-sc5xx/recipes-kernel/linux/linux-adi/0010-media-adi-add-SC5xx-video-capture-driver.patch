+static irqreturn_t adi_cap_isr(int irq, void *dev_id)
+{
+	struct ppi_if *ppi = dev_id;
+	struct adi_cap_device *adi_cap_dev = ppi->priv;
+	struct adi_cap_buffer *buf;
+	struct vb2_v4l2_buffer *vbuf;
+	struct vb2_buffer *vb;
+	bool ppi_err;
+
+	spin_lock(&adi_cap_dev->lock);
+
+	adi_cap_dev->dma_irq_events++;
+	ppi_err = atomic_xchg(&ppi->err, 0);
+	if (ppi_err)
+		adi_cap_dev->ppi_error_events++;
+	adi_cap_log_dma_state(adi_cap_dev, "irq entry");
+
+	buf = adi_cap_dev->cur_frm;
+	if (!buf) {
+		adi_cap_dev->dma_queue_empty_events++;
+		goto stop_dma;
+	}
+
+	vbuf = &buf->vb;
+	vb = &vbuf->vb2_buf;
+	vb->timestamp = ktime_get_ns();
+	if (ppi_err) {
+		adi_cap_dev->errored_frame_events++;
+		vb2_buffer_done(vb, VB2_BUF_STATE_ERROR);
+	} else {
+		vbuf->sequence = adi_cap_dev->sequence++;
+		adi_cap_dev->captured_frame_events++;
+		vb2_buffer_done(vb, VB2_BUF_STATE_DONE);
+	}
+
+	adi_cap_dev->cur_frm = NULL;
+	if (!adi_cap_take_next_buffer(adi_cap_dev))
+		adi_cap_dev->dma_queue_empty_events++;
+
+stop_dma:
+	ppi->ops->stop(ppi);
+	adi_cap_log_dma_state(adi_cap_dev, "irq after ppi_stop");
+
+	if (!adi_cap_dev->stop && adi_cap_dev->cur_frm) {
+		adi_cap_update_dma_target(adi_cap_dev, adi_cap_dev->cur_frm);
+		ppi->ops->start(ppi);
+		adi_cap_log_dma_state(adi_cap_dev, "irq after restart");
+	}
+
+	spin_unlock(&adi_cap_dev->lock);
+
+	return IRQ_HANDLED;
+}
