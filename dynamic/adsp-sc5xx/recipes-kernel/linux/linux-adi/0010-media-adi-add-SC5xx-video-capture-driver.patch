+++ b/drivers/media/platform/adi/Makefile
@@ -1 +1,2 @@
+obj-$(CONFIG_VIDEO_ADI_CAPTURE) += adi_capture.o
 obj-$(CONFIG_VIDEO_ADI_PPI) += ppi.o
