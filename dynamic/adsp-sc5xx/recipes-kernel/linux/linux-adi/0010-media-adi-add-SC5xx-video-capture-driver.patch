+static struct adi_capture_config *adi_get_config(struct platform_device *pdev)
+{
+	struct adi_capture_config *config;
+	struct device_node *node = pdev->dev.of_node;
+	struct ppi_info *info;
+	const char *string;
+	struct v4l2_input *input;
+	struct adi_cap_route *route;
+	struct resource *res;
+	u32 val;
+	u32 spu;
+
+	config = (struct adi_capture_config *)pdev->dev.platform_data;
+	if (!config)
+		config = devm_kzalloc(&pdev->dev, sizeof(*config), GFP_KERNEL);
+	if (!config)
+		return NULL;
+
+	/*Initialize ppi info struct*/
+	info = devm_kzalloc(&pdev->dev, sizeof(*info), GFP_KERNEL);
+	if (!info) {
+		dev_err(&pdev->dev, "failed to alloc ppi info\n");
+		return NULL;
+	}
+	info->type = (enum ppi_type)get_int_prop(node, "type");
+	info->dma_ch = get_int_prop(node, "dma-channel");
+	info->irq_err = platform_get_irq(pdev, 0);
+	info->spu = -1;
+	if (!of_property_read_u32(node, "spu_securep_id", &spu))
+		info->spu = spu;
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	info->base = devm_ioremap_resource(&pdev->dev, res);
+	if (!(info->base)) {
+		dev_err(&pdev->dev, "failed to get mem resource");
+		return NULL;
+	}
+
+	config->i2c_adapter_id = get_int_prop(node, "i2c_bus_id");
+	if (of_property_read_string(node, "card-name", &string))
+		string = dev_name(&pdev->dev);
+	config->card_name = (char *)string;
+	config->ppi_info = info;
+
+	if (adi_cap_parse_dma_layout(&pdev->dev, node, &config->dma_layout))
+		return NULL;
+	if (adi_cap_parse_readout_layout(&pdev->dev, node,
+					 &config->readout_layout))
+		return NULL;
+
+	if (!of_property_read_u32(node, "adi,ppi-control", &val))
+		config->ppi_control = val;
+	if (!of_property_read_u32(node, "adi,int-mask", &val))
+		config->int_mask = val;
+	if (!of_property_read_u32(node, "adi,blank-pixels", &val))
+		config->blank_pixels = val;
+
+	input = devm_kzalloc(&pdev->dev, sizeof(*input), GFP_KERNEL);
+	if (!input)
+		return NULL;
+	route = devm_kzalloc(&pdev->dev, sizeof(*route), GFP_KERNEL);
+	if (!route)
+		return NULL;
+
+	input->index = 0;
+	input->type = V4L2_INPUT_TYPE_CAMERA;
+	input->std = V4L2_STD_UNKNOWN;
+	if (of_property_read_string(node, "adi,input-name", &string))
+		string = config->card_name;
+	strscpy(input->name, string, sizeof(input->name));
+
+	route->input = get_int_prop(node, "adi,route-input");
+	route->output = get_int_prop(node, "adi,route-output");
+	if (!of_property_read_u32(node, "adi,route-ppi-control", &val))
+		route->ppi_control = val;
+
+	config->inputs = input;
+	config->num_inputs = 1;
+	config->routes = route;
+
+	config->subdev_node = of_parse_phandle(node, "adi,subdev", 0);
+	if (config->subdev_node) {
+		if (devm_add_action_or_reset(&pdev->dev, adi_cap_of_node_put,
+					     config->subdev_node))
+			return NULL;
+	} else if (!of_property_read_string(node, "adi,subdev-name", &string)) {
+		strscpy(config->board_info.type, string,
+			sizeof(config->board_info.type));
+		if (of_property_read_u32(node, "adi,subdev-address", &val)) {
+			dev_err(&pdev->dev, "missing adi,subdev-address\n");
+			return NULL;
+		}
+		config->board_info.addr = val;
+		config->board_info.platform_data =
+			devm_gpiod_get_optional(&pdev->dev, "nrst",
+						GPIOD_OUT_HIGH);
+		if (IS_ERR(config->board_info.platform_data)) {
+			dev_err(&pdev->dev, "failed to get legacy nrst gpio\n");
+			return NULL;
+		}
+	} else {
+		dev_err(&pdev->dev,
+			"missing adi,subdev phandle or legacy subdev properties\n");
+		return NULL;
+	}
+
+	return config;
+}
