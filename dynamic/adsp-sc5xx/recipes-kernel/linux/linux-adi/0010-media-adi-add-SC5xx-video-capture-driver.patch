+static irqreturn_t adi_cap_isr(int irq, void *dev_id);
+
+static struct adi_cap_buffer *to_adi_cap_vb(struct vb2_v4l2_buffer *vb)
+{
+	return container_of(vb, struct adi_cap_buffer, vb);
+}
+
+static bool adi_cap_has_dma_layout(struct adi_cap_device *adi_cap_dev)
+{
+	return adi_cap_dev->cfg->dma_layout != ADI_CAP_DMA_LAYOUT_LINEAR;
+}
+
+static int adi_cap_readout_dimensions(struct adi_cap_device *adi_cap_dev,
+				      u32 width, u32 height,
+				      u32 *readout_width,
+				      u32 *readout_height)
+{
+	switch (adi_cap_dev->cfg->readout_layout) {
+	case ADI_CAP_READOUT_LAYOUT_NATIVE:
+		*readout_width = width;
+		*readout_height = height;
+		return 0;
+	case ADI_CAP_READOUT_LAYOUT_DOUBLE_WIDTH_HALF_HEIGHT:
+		if (width > (u32)(~0U / 2) || height % 2)
+			return -EINVAL;
+
+		*readout_width = width * 2;
+		*readout_height = height / 2;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int adi_cap_logical_dimensions(struct adi_cap_device *adi_cap_dev,
+				      u32 readout_width,
+				      u32 readout_height,
+				      u32 *width, u32 *height)
+{
+	switch (adi_cap_dev->cfg->readout_layout) {
+	case ADI_CAP_READOUT_LAYOUT_NATIVE:
+		*width = readout_width;
+		*height = readout_height;
+		return 0;
+	case ADI_CAP_READOUT_LAYOUT_DOUBLE_WIDTH_HALF_HEIGHT:
+		if (readout_width % 2 || readout_height > (u32)(~0U / 2))
+			return -EINVAL;
+
+		*width = readout_width / 2;
+		*height = readout_height * 2;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int adi_cap_mbus_to_readout(struct adi_cap_device *adi_cap_dev,
+				   struct v4l2_mbus_framefmt *format)
+{
+	return adi_cap_readout_dimensions(adi_cap_dev, format->width,
+					  format->height, &format->width,
+					  &format->height);
+}
+
+static int adi_cap_mbus_to_logical(struct adi_cap_device *adi_cap_dev,
+				   struct v4l2_mbus_framefmt *format)
+{
+	return adi_cap_logical_dimensions(adi_cap_dev, format->width,
+					  format->height, &format->width,
+					  &format->height);
+}
+
+static u32 adi_cap_desc_dma_config(void)
+{
+	return DMARESTART | DMATOVEN | WNR | WDSIZE_256 | PSIZE_32 |
+	       NDSIZE_4 | DMAFLOW_LIST | DMAEN;
+}
+
+static u32 adi_cap_desc_x_count(u32 logical_line_size)
+{
+	return logical_line_size / 32;
+}
+
+static u32 adi_cap_desc_x_modify(struct adi_cap_device *adi_cap_dev)
+{
+	return 32;
+}
+
+static int adi_cap_center_out_desc_config(struct adi_cap_device *adi_cap_dev,
+					  u32 *logical_line_size,
+					  unsigned int *desc_count)
+{
+	u32 readout_width;
+	u32 readout_height;
+	u32 readout_line_size;
+	int ret;
+
+	ret = adi_cap_readout_dimensions(adi_cap_dev, adi_cap_dev->fmt.width,
+					 adi_cap_dev->fmt.height,
+					 &readout_width, &readout_height);
+	if (ret)
+		return ret;
+
+	if (readout_width % 2) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+			 "interleaved-center-out layout requires two logical lines per hardware line\n");
+		return -EINVAL;
+	}
+
+	readout_line_size = readout_width * adi_cap_dev->bpp / 8;
+	*logical_line_size = readout_line_size / 2;
+	if (*logical_line_size % 32) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+			 "interleaved-center-out layout requires 32-byte aligned logical lines\n");
+		return -EINVAL;
+	}
+
+	if (readout_height > (u32)(~0U / 2))
+		return -EINVAL;
+
+	*desc_count = readout_height * 2;
+	return 0;
+}
+
+static void adi_cap_log_dma_state(struct adi_cap_device *adi_cap_dev,
+				  const char *tag)
+{
+	struct ppi_if *ppi = adi_cap_dev->ppi;
+	void __iomem *dma_base = ppi->info->dma_base;
+	dma_addr_t next_desc;
+	dma_addr_t curr_desc;
+	dma_addr_t start_addr;
+	dma_addr_t curr_addr;
+
+	if (debug < ADI_CAP_LOG_DMA)
+		return;
+
+	next_desc = get_dma_next_desc_ptr(dma_base);
+	curr_desc = get_dma_curr_desc_ptr(dma_base);
+	start_addr = get_dma_start_addr(dma_base);
+	curr_addr = get_dma_curr_addr(dma_base);
+
+	v4l2_dbg(ADI_CAP_LOG_DMA, debug, &adi_cap_dev->v4l2_dev,
+		 "%s DMA: cfg 0x%08lx stat 0x%08lx next %pad curr_desc %pad start %pad curr_addr %pad xcnt %lu xcur %lu xmod %ld ycnt %lu ycur %lu ymod %ld\n",
+		 tag, get_dma_config(dma_base), get_dma_curr_irqstat(dma_base),
+		 &next_desc, &curr_desc, &start_addr, &curr_addr,
+		 get_dma_x_count(dma_base), get_dma_curr_xcount(dma_base),
+		 get_dma_x_modify(dma_base), get_dma_y_count(dma_base),
+		 get_dma_curr_ycount(dma_base), get_dma_y_modify(dma_base));
+}
+
+/*
+ * EPC660 native readout packs two logical image rows into one PPI line.
+ * adi,readout-layout can keep the public V4L2 format logical while PPI sees
+ * the adjusted hardware frame size, e.g. logical 320x240 as 640x120.
+ *
+ * Each incoming PPI line contains:
+ *   upper-center row, lower-center row
+ *
+ * Then the sensor walks center-out:
+ *   row119,row120, row118,row121, ... for a 240-row logical image.
+ *
+ * The DMA descriptor ring splits each hardware line into two half-line
+ * transfers. Preserve the legacy line sorter orientation by writing the first
+ * half-line into the lower half of the destination image, then the second into
+ * the upper half.
+ */
+static int adi_cap_setup_interleaved_center_out_descs(struct vb2_buffer *vb)
+{
+	struct adi_cap_device *adi_cap_dev = vb2_get_drv_priv(vb->vb2_queue);
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct adi_cap_buffer *buf = to_adi_cap_vb(vbuf);
+	struct adi_cap_dma_desc *desc;
+	dma_addr_t start_addr;
+	u32 desc_cfg;
+	u32 logical_line_size;
+	u32 half_image_size;
+	u32 next_desc_dma;
+	unsigned int desc_count;
+	unsigned int readout_height;
+	unsigned int i;
+	int ret;
+
+	ret = adi_cap_center_out_desc_config(adi_cap_dev, &logical_line_size,
+					     &desc_count);
+	if (ret)
+		return ret;
+
+	buf->desc_size = desc_count * sizeof(*desc);
+	buf->dma_desc = dma_alloc_coherent(vb->vb2_queue->dev,
+					   buf->desc_size,
+					   &buf->desc_dma_addr, GFP_KERNEL);
+	if (!buf->dma_desc)
+		return -ENOMEM;
+
+	desc = buf->dma_desc;
+	start_addr = vb2_dma_contig_plane_dma_addr(vb, 0);
+	readout_height = desc_count / 2;
+	half_image_size = logical_line_size * readout_height;
+	next_desc_dma = lower_32_bits(buf->desc_dma_addr + sizeof(*desc));
+	desc_cfg = adi_cap_desc_dma_config();
+
+	/* Match the legacy sorter: lower half first, then upper half. */
+	for (i = 0; i < readout_height; i++) {
+		desc->next_desc_addr = next_desc_dma;
+		desc->start_addr = lower_32_bits(start_addr + half_image_size +
+						 i * logical_line_size);
+		desc->cfg = desc_cfg;
+		desc->x_count = adi_cap_desc_x_count(logical_line_size);
+		desc->x_modify = adi_cap_desc_x_modify(adi_cap_dev);
+		desc++;
+		next_desc_dma += sizeof(*desc);
+
+		desc->next_desc_addr = next_desc_dma;
+		desc->start_addr = lower_32_bits(start_addr + half_image_size -
+						 (i + 1) * logical_line_size);
+		desc->cfg = desc_cfg;
+		desc->x_count = adi_cap_desc_x_count(logical_line_size);
+		desc->x_modify = adi_cap_desc_x_modify(adi_cap_dev);
+		desc++;
+		next_desc_dma += sizeof(*desc);
+	}
+
+	desc = buf->dma_desc;
+	desc->cfg |= DESCIDCPY;
+
+	desc = (struct adi_cap_dma_desc *)buf->dma_desc +
+	       desc_count - 1;
+	desc->next_desc_addr = lower_32_bits(buf->desc_dma_addr);
+	desc->cfg |= DI_EN_X;
+
+	desc = buf->dma_desc;
+	v4l2_dbg(ADI_CAP_LOG_DMA, debug, &adi_cap_dev->v4l2_dev,
+		 "dma desc setup: buf %pad desc %pad count %u size %zu logical_line %u xcnt %u xmod %u first[start 0x%08x cfg 0x%08x] second[start 0x%08x cfg 0x%08x] last[start 0x%08x cfg 0x%08x next 0x%08x]\n",
+		 &start_addr, &buf->desc_dma_addr, desc_count, buf->desc_size,
+		 logical_line_size, adi_cap_desc_x_count(logical_line_size),
+		 adi_cap_desc_x_modify(adi_cap_dev), desc[0].start_addr,
+		 desc[0].cfg, desc[1].start_addr, desc[1].cfg,
+		 desc[desc_count - 1].start_addr, desc[desc_count - 1].cfg,
+		 desc[desc_count - 1].next_desc_addr);
+
+	return 0;
+}
+
+static void adi_cap_free_dma_descs(struct vb2_buffer *vb)
+{
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct adi_cap_buffer *buf = to_adi_cap_vb(vbuf);
+
+	if (!buf->dma_desc)
+		return;
+
+	dma_free_coherent(vb->vb2_queue->dev, buf->desc_size, buf->dma_desc,
+			  buf->desc_dma_addr);
+	buf->dma_desc = NULL;
+	buf->desc_dma_addr = 0;
+	buf->desc_size = 0;
+}
+
+static int adi_cap_setup_dma_descs(struct vb2_buffer *vb)
+{
+	struct adi_cap_device *adi_cap_dev = vb2_get_drv_priv(vb->vb2_queue);
+
+	switch (adi_cap_dev->cfg->dma_layout) {
+	case ADI_CAP_DMA_LAYOUT_LINEAR:
+		return 0;
+	case ADI_CAP_DMA_LAYOUT_INTERLEAVED_CENTER_OUT:
+		return adi_cap_setup_interleaved_center_out_descs(vb);
+	default:
+		return -EINVAL;
+	}
+}
+
+static void adi_cap_update_dma_target(struct adi_cap_device *adi_cap_dev,
+				      struct adi_cap_buffer *buf)
+{
+	struct ppi_if *ppi = adi_cap_dev->ppi;
+	dma_addr_t addr;
+
+	if (adi_cap_has_dma_layout(adi_cap_dev)) {
+		struct adi_cap_dma_desc *desc = buf->dma_desc;
+		u32 logical_line_size;
+		unsigned int desc_count;
+		int ret;
+
+		ret = adi_cap_center_out_desc_config(adi_cap_dev,
+						     &logical_line_size,
+						     &desc_count);
+		if (ret)
+			return;
+
+		v4l2_dbg(ADI_CAP_LOG_DMA, debug, &adi_cap_dev->v4l2_dev,
+			 "dma target desc: desc %pad count %u xcnt %u xmod %u cfg 0x%08x first 0x%08x last 0x%08x\n",
+			 &buf->desc_dma_addr, desc_count,
+			 adi_cap_desc_x_count(logical_line_size),
+			 adi_cap_desc_x_modify(adi_cap_dev),
+			 adi_cap_desc_dma_config(), desc[0].start_addr,
+			 desc[desc_count - 1].start_addr);
+		ppi->ops->update_desc(ppi, buf->desc_dma_addr,
+				      adi_cap_desc_x_count(logical_line_size),
+				      adi_cap_desc_x_modify(adi_cap_dev),
+				      adi_cap_desc_dma_config());
+		adi_cap_log_dma_state(adi_cap_dev, "after update_desc");
+		return;
+	}
+
+	addr = vb2_dma_contig_plane_dma_addr(&buf->vb.vb2_buf, 0);
+	v4l2_dbg(ADI_CAP_LOG_DMA, debug, &adi_cap_dev->v4l2_dev,
+		 "dma target linear: addr %pad\n", &addr);
+	ppi->ops->update_addr(ppi, (unsigned long)addr);
+	adi_cap_log_dma_state(adi_cap_dev, "after update_addr");
+}
+
+static bool adi_cap_take_next_buffer(struct adi_cap_device *adi_cap_dev)
+{
+	if (list_empty(&adi_cap_dev->dma_queue))
+		return false;
+
+	adi_cap_dev->cur_frm = list_first_entry(&adi_cap_dev->dma_queue,
+						struct adi_cap_buffer, list);
+	list_del_init(&adi_cap_dev->cur_frm->list);
+
+	return true;
+}
+
+static void adi_cap_reset_stream_stats(struct adi_cap_device *adi_cap_dev)
+{
+	adi_cap_dev->dma_irq_events = 0;
+	adi_cap_dev->captured_frame_events = 0;
+	adi_cap_dev->errored_frame_events = 0;
+	adi_cap_dev->ppi_error_events = 0;
+	adi_cap_dev->dma_queue_empty_events = 0;
+}
+
+static void adi_cap_log_stream_stats(struct adi_cap_device *adi_cap_dev)
+{
+	v4l2_dbg(ADI_CAP_LOG_REPORT, debug, &adi_cap_dev->v4l2_dev,
+		 "PPI DMA IRQ events: %llu\n", adi_cap_dev->dma_irq_events);
+	v4l2_dbg(ADI_CAP_LOG_REPORT, debug, &adi_cap_dev->v4l2_dev,
+		 "Captured frame events: %llu\n",
+		 adi_cap_dev->captured_frame_events);
+	v4l2_dbg(ADI_CAP_LOG_REPORT, debug, &adi_cap_dev->v4l2_dev,
+		 "Errored frame events: %llu\n",
+		 adi_cap_dev->errored_frame_events);
+	v4l2_dbg(ADI_CAP_LOG_REPORT, debug, &adi_cap_dev->v4l2_dev,
+		 "PPI error events: %llu\n", adi_cap_dev->ppi_error_events);
+	v4l2_dbg(ADI_CAP_LOG_REPORT, debug, &adi_cap_dev->v4l2_dev,
+		 "DMA queue empty events: %llu\n",
+		 adi_cap_dev->dma_queue_empty_events);
+}
