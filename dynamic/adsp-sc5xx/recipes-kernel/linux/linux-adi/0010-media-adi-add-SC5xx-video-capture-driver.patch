+static int adi_cap_parse_dma_layout(struct device *dev,
+				    struct device_node *node,
+				    enum adi_cap_dma_layout *layout)
+{
+	const char *layout_name;
+	int ret;
+
+	*layout = ADI_CAP_DMA_LAYOUT_LINEAR;
+
+	ret = of_property_read_string(node, "adi,dma-layout", &layout_name);
+	if (ret == -EINVAL)
+		return 0;
+	if (ret)
+		return ret;
+
+	if (!strcmp(layout_name, "linear")) {
+		*layout = ADI_CAP_DMA_LAYOUT_LINEAR;
+		return 0;
+	}
+	if (!strcmp(layout_name, "interleaved-center-out")) {
+		*layout = ADI_CAP_DMA_LAYOUT_INTERLEAVED_CENTER_OUT;
+		return 0;
+	}
+
+	dev_err(dev, "unsupported adi,dma-layout: %s\n", layout_name);
+	return -EINVAL;
+}
+
+static int adi_cap_parse_readout_layout(struct device *dev,
+					struct device_node *node,
+					enum adi_cap_readout_layout *layout)
+{
+	const char *layout_name;
+	int ret;
+
+	*layout = ADI_CAP_READOUT_LAYOUT_NATIVE;
+
+	ret = of_property_read_string(node, "adi,readout-layout",
+				      &layout_name);
+	if (ret == -EINVAL)
+		return 0;
+	if (ret)
+		return ret;
+
+	if (!strcmp(layout_name, "native")) {
+		*layout = ADI_CAP_READOUT_LAYOUT_NATIVE;
+		return 0;
+	}
+	if (!strcmp(layout_name, "double-width-half-height") ||
+	    !strcmp(layout_name, "2x-width-half-height")) {
+		*layout = ADI_CAP_READOUT_LAYOUT_DOUBLE_WIDTH_HALF_HEIGHT;
+		return 0;
+	}
+
+	dev_err(dev, "unsupported adi,readout-layout: %s\n", layout_name);
+	return -EINVAL;
+}
