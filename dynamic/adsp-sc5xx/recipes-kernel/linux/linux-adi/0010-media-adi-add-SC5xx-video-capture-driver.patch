+static int adi_cap_querycap(struct file *file, void  *priv,
+				struct v4l2_capability *cap)
+{
+	struct adi_cap_device *adi_cap_dev = video_drvdata(file);
+
+	cap->device_caps = V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_STREAMING;
+	cap->capabilities = cap->device_caps | V4L2_CAP_DEVICE_CAPS;
+	strscpy(cap->driver, CAPTURE_DRV_NAME, sizeof(cap->driver));
+	strscpy(cap->bus_info, "ADI SC5XX Platform", sizeof(cap->bus_info));
+	strscpy(cap->card, adi_cap_dev->cfg->card_name, sizeof(cap->card));
+	return 0;
+}
