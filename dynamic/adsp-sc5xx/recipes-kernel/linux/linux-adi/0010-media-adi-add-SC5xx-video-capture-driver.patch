+static int adi_cap_register_subdev(struct platform_device *pdev,
+				   struct adi_cap_device *adi_cap_dev)
+{
+	struct adi_capture_config *config = adi_cap_dev->cfg;
+	struct i2c_adapter *i2c_adap;
+
+#ifdef CONFIG_OF
+	if (config->subdev_node) {
+		struct i2c_client *client;
+		struct v4l2_subdev *sd;
+		int ret;
+
+		client = of_find_i2c_device_by_node(config->subdev_node);
+		if (!client)
+			return -EPROBE_DEFER;
+
+		sd = i2c_get_clientdata(client);
+		if (!sd) {
+			put_device(&client->dev);
+			return -EPROBE_DEFER;
+		}
+
+		ret = v4l2_device_register_subdev(&adi_cap_dev->v4l2_dev, sd);
+		put_device(&client->dev);
+		if (ret)
+			return ret;
+
+		adi_cap_dev->sd = sd;
+		return 0;
+	}
+#endif
+
+	i2c_adap = i2c_get_adapter(config->i2c_adapter_id);
+	if (!i2c_adap) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+				"Unable to find i2c adapter\n");
+		return -ENODEV;
+	}
+
+	adi_cap_dev->sd = v4l2_i2c_new_subdev_board(&adi_cap_dev->v4l2_dev,
+						 i2c_adap,
+						 &config->board_info,
+						 NULL);
+	i2c_put_adapter(i2c_adap);
+	if (!adi_cap_dev->sd) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+				"Unable to register sub device\n");
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+static void adi_cap_unregister_subdev(struct adi_cap_device *adi_cap_dev)
+{
+#ifdef CONFIG_OF
+	if (adi_cap_dev->cfg->subdev_node && adi_cap_dev->sd) {
+		v4l2_device_unregister_subdev(adi_cap_dev->sd);
+		adi_cap_dev->sd = NULL;
+	}
+#endif
+}
+
+static void adi_cap_release_reserved_mem(struct platform_device *pdev,
+					 struct adi_cap_device *adi_cap_dev)
+{
+	if (!adi_cap_dev->reserved_mem_bound)
+		return;
+
+	of_reserved_mem_device_release(&pdev->dev);
+	adi_cap_dev->reserved_mem_bound = false;
+}
+
+static int adi_cap_init_reserved_mem(struct platform_device *pdev,
+				     struct adi_cap_device *adi_cap_dev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *mem_np;
+	struct reserved_mem *rmem;
+	phys_addr_t end;
+	int ret;
+
+	if (!dev->of_node)
+		return 0;
+
+	ret = dma_coerce_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to set 32-bit DMA mask\n");
+
+	mem_np = of_parse_phandle(dev->of_node, "memory-region", 0);
+	if (!mem_np) {
+		dev_info(dev,
+			 "no reserved capture DMA pool; MMAP buffers use default DMA allocator\n");
+		return 0;
+	}
+
+	rmem = of_reserved_mem_lookup(mem_np);
+	of_node_put(mem_np);
+	if (!rmem)
+		return dev_err_probe(dev, -EINVAL,
+				     "failed to look up reserved memory-region\n");
+
+	if (!rmem->size)
+		return dev_err_probe(dev, -EINVAL,
+				     "reserved memory-region is empty\n");
+
+	if (rmem->base > DMA_BIT_MASK(32) ||
+	    rmem->size - 1 > DMA_BIT_MASK(32) - rmem->base)
+		return dev_err_probe(dev, -EOVERFLOW,
+				     "reserved memory-region is outside 32-bit DMA range\n");
+
+	ret = of_reserved_mem_device_init(dev);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to bind reserved memory-region\n");
+
+	adi_cap_dev->reserved_mem_bound = true;
+	end = rmem->base + rmem->size - 1;
+	dev_info(dev, "using reserved capture DMA pool %s at %pa-%pa\n",
+		 rmem->name, &rmem->base, &end);
+
+	return 0;
+}
+
+static int adi_cap_probe(struct platform_device *pdev)
+{
+	struct adi_cap_device *adi_cap_dev;
+	struct video_device *vfd;
+	struct adi_capture_config *config = NULL;
+	struct vb2_queue *q;
+	struct adi_cap_route *route;
+	struct device *dev = &pdev->dev;
+	int ret;
+
+#ifdef CONFIG_OF
+	if (!of_match_device(adi_cap_match, &pdev->dev)) {
+		dev_err(dev, "failed to matching of_match node\n");
+		return -ENODEV;
+	}
+
+	if (dev->of_node)
+		config = adi_get_config(pdev);
+#else
+	config = pdev->dev.platform_data;
+	if (!config || !config->num_inputs) {
+		v4l2_err(pdev->dev.driver, "Unable to get board config\n");
+		return -ENODEV;
+	}
+#endif
+	if (!config || !config->num_inputs) {
+		dev_err(dev, "Unable to get capture config\n");
+		return -ENODEV;
+	}
+
+	adi_cap_dev = kzalloc(sizeof(*adi_cap_dev), GFP_KERNEL);
+	if (!adi_cap_dev)
+		return -ENOMEM;
+
+	adi_cap_dev->cfg = config;
+
+	ret = adi_cap_init_reserved_mem(pdev, adi_cap_dev);
+	if (ret)
+		goto err_free_dev;
+
+	adi_cap_dev->ppi = ppi_create_instance(pdev, config->ppi_info);
+	if (IS_ERR(adi_cap_dev->ppi)) {
+		ret = PTR_ERR(adi_cap_dev->ppi);
+		v4l2_err(pdev->dev.driver, "Unable to create ppi: %d\n", ret);
+		goto err_release_reserved_mem;
+	}
+	adi_cap_dev->ppi->priv = adi_cap_dev;
+
+	vfd = &adi_cap_dev->video_dev;
+	/* initialize field of video device */
+	vfd->release            = video_device_release_empty;
+	vfd->fops               = &adi_cap_fops;
+	vfd->ioctl_ops          = &adi_cap_ioctl_ops;
+	vfd->tvnorms            = 0;
+	vfd->v4l2_dev           = &adi_cap_dev->v4l2_dev;
+	vfd->device_caps        = V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_STREAMING;
+	vfd->vfl_dir            = VFL_DIR_RX;
+	strscpy(vfd->name, CAPTURE_DRV_NAME, sizeof(vfd->name));
+
+	ret = v4l2_device_register(&pdev->dev, &adi_cap_dev->v4l2_dev);
+	if (ret) {
+		v4l2_err(pdev->dev.driver,
+				"Unable to register v4l2 device\n");
+		goto err_free_ppi;
+	}
+	platform_set_drvdata(pdev, &adi_cap_dev->v4l2_dev);
+	v4l2_info(&adi_cap_dev->v4l2_dev, "v4l2 device registered\n");
+
+	adi_cap_dev->v4l2_dev.ctrl_handler = &adi_cap_dev->ctrl_handler;
+	ret = v4l2_ctrl_handler_init(&adi_cap_dev->ctrl_handler, 0);
+	if (ret) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+				"Unable to init control handler\n");
+		goto err_unreg_v4l2;
+	}
+
+	spin_lock_init(&adi_cap_dev->lock);
+	mutex_init(&adi_cap_dev->mutex);
+	/* initialize queue */
+	q = &adi_cap_dev->buffer_queue;
+	q->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	q->io_modes = VB2_DMABUF | VB2_MMAP;
+	q->drv_priv = adi_cap_dev;
+	q->buf_struct_size = sizeof(struct adi_cap_buffer);
+	q->ops = &adi_cap_video_qops;
+	q->mem_ops = &vb2_dma_contig_memops;
+	q->dma_attrs = DMA_ATTR_WRITE_COMBINE;
+	q->dma_dir = DMA_FROM_DEVICE;
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC;
+	q->lock = &adi_cap_dev->mutex;
+	q->min_buffers_needed = 1;
+	q->dev = &pdev->dev;
+
+	ret = vb2_queue_init(q);
+	if (ret)
+		goto err_free_handler;
+
+	/* init video dma queues */
+	INIT_LIST_HEAD(&adi_cap_dev->dma_queue);
+
+	vfd->lock = &adi_cap_dev->mutex;
+	vfd->queue = q;
+
+	/* register video device */
+	ret = video_register_device(&adi_cap_dev->video_dev, VFL_TYPE_VIDEO, -1);
+	if (ret) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+				"Unable to register video device\n");
+		goto err_free_handler;
+	}
+	video_set_drvdata(&adi_cap_dev->video_dev, adi_cap_dev);
+	v4l2_info(&adi_cap_dev->v4l2_dev, "video device registered as: %s\n",
+			video_device_node_name(vfd));
+
+	/* load up the subdevice */
+	ret = adi_cap_register_subdev(pdev, adi_cap_dev);
+	if (!ret) {
+		int i;
+
+		/* update tvnorms from the sub devices */
+		for (i = 0; i < config->num_inputs; i++)
+			vfd->tvnorms |= config->inputs[i].std;
+	} else {
+		goto err_unreg_vdev;
+	}
+
+	v4l2_info(&adi_cap_dev->v4l2_dev, "v4l2 sub device registered: %s\n",
+		  adi_cap_dev->sd->name);
+	ret = v4l2_device_register_subdev_nodes(&adi_cap_dev->v4l2_dev);
+	if (ret) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+				"subdev nodes cannot be registered\n");
+		goto err_unreg_vdev;
+	}
+
+	/*
+	 * explicitly set input, otherwise some boards
+	 * may not work at the state as we expected
+	 */
+	route = &config->routes[0];
+	ret = v4l2_subdev_call(adi_cap_dev->sd, video, s_routing,
+				route->input, route->output, 0);
+	if ((ret < 0) && (ret != -ENOIOCTLCMD)) {
+		v4l2_err(&adi_cap_dev->v4l2_dev, "Failed to set input\n");
+		goto err_unreg_vdev;
+	}
+	adi_cap_dev->cur_input = 0;
+	/* if this route has specific config, update ppi control */
+	if (route->ppi_control)
+		config->ppi_control = route->ppi_control;
+
+	/* now we can probe the default state */
+	if (config->inputs[0].capabilities & V4L2_IN_CAP_STD) {
+		v4l2_std_id std;
+		ret = v4l2_subdev_call(adi_cap_dev->sd, video, g_std, &std);
+		if (ret) {
+			v4l2_err(&adi_cap_dev->v4l2_dev,
+					"Unable to get std\n");
+			goto err_unreg_vdev;
+		}
+		adi_cap_dev->std = std;
+	}
+	if (config->inputs[0].capabilities & V4L2_IN_CAP_DV_TIMINGS) {
+		struct v4l2_dv_timings dv_timings;
+		ret = v4l2_subdev_call(adi_cap_dev->sd, video,
+				g_dv_timings, &dv_timings);
+		if (ret) {
+			v4l2_err(&adi_cap_dev->v4l2_dev,
+					"Unable to get dv timings\n");
+			goto err_unreg_vdev;
+		}
+		adi_cap_dev->dv_timings = dv_timings;
+	}
+	ret = adi_cap_init_sensor_formats(adi_cap_dev);
+	if (ret) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+				"Unable to create sensor formats table\n");
+		goto err_unreg_vdev;
+	}
+	return 0;
+err_unreg_vdev:
+	adi_cap_unregister_subdev(adi_cap_dev);
+	video_unregister_device(&adi_cap_dev->video_dev);
+err_free_handler:
+	v4l2_ctrl_handler_free(&adi_cap_dev->ctrl_handler);
+err_unreg_v4l2:
+	v4l2_device_unregister(&adi_cap_dev->v4l2_dev);
+err_free_ppi:
+	ppi_delete_instance(adi_cap_dev->ppi);
+err_release_reserved_mem:
+	adi_cap_release_reserved_mem(pdev, adi_cap_dev);
+err_free_dev:
+	kfree(adi_cap_dev);
+	return ret;
+}
+
+static int adi_cap_remove(struct platform_device *pdev)
+{
+	struct v4l2_device *v4l2_dev = platform_get_drvdata(pdev);
+	struct adi_cap_device *adi_cap_dev = container_of(v4l2_dev,
+						struct adi_cap_device, v4l2_dev);
+
+	adi_cap_free_sensor_formats(adi_cap_dev);
+	adi_cap_unregister_subdev(adi_cap_dev);
+	video_unregister_device(&adi_cap_dev->video_dev);
+	v4l2_ctrl_handler_free(&adi_cap_dev->ctrl_handler);
+	v4l2_device_unregister(v4l2_dev);
+	ppi_delete_instance(adi_cap_dev->ppi);
+	adi_cap_release_reserved_mem(pdev, adi_cap_dev);
+	kfree(adi_cap_dev);
+	return 0;
+}
+
+static struct platform_driver adi_cap_driver = {
+	.driver = {
+		.name  = CAPTURE_DRV_NAME,
+#ifdef CONFIG_OF
+		.of_match_table = adi_cap_match,
+#endif
+	},
+	.probe = adi_cap_probe,
+	.remove = adi_cap_remove,
+};
+module_platform_driver(adi_cap_driver);
+
+MODULE_DESCRIPTION("Analog Devices SC5XX video capture driver");
+MODULE_AUTHOR("Scott Jiang <Scott.Jiang.Linux@gmail.com>");
+MODULE_LICENSE("GPL v2");
diff --git a/include/media/adi/adi_capture.h b/include/media/adi/adi_capture.h
new file mode 100644
index 0000000000000..eed1bf5244378
--- /dev/null
+++ b/include/media/adi/adi_capture.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ADI_CAPTURE_H_
+#define _ADI_CAPTURE_H_
+
+#include <linux/i2c.h>
+
+struct v4l2_input;
+struct ppi_info;
+struct device_node;
+
+struct adi_cap_route {
+	u32 input;
+	u32 output;
+	u32 ppi_control;
+};
+
+enum adi_cap_dma_layout {
+	ADI_CAP_DMA_LAYOUT_LINEAR,
+	/* PPI lines contain upper/lower logical rows emitted center-out. */
+	ADI_CAP_DMA_LAYOUT_INTERLEAVED_CENTER_OUT,
+};
+
+enum adi_cap_readout_layout {
+	ADI_CAP_READOUT_LAYOUT_NATIVE,
+	/* PPI sees two logical rows as one double-width line. */
+	ADI_CAP_READOUT_LAYOUT_DOUBLE_WIDTH_HALF_HEIGHT,
+};
+
+struct adi_capture_config {
+	/* card name */
+	char *card_name;
+	/* inputs available at the sub device */
+	struct v4l2_input *inputs;
+	/* number of inputs supported */
+	int num_inputs;
+	/* routing information for each input */
+	struct adi_cap_route *routes;
+	/* i2c bus adapter no */
+	int i2c_adapter_id;
+	/* i2c subdevice board info */
+	struct i2c_board_info board_info;
+	/* native DT subdevice node */
+	struct device_node *subdev_node;
+	/* ppi board info */
+	const struct ppi_info *ppi_info;
+	/* ppi control */
+	unsigned long ppi_control;
+	/* ppi interrupt mask */
+	u32 int_mask;
+	/* horizontal blanking pixels */
+	int blank_pixels;
+	/* DMA write layout */
+	enum adi_cap_dma_layout dma_layout;
+	/* Sensor/PPI readout layout */
+	enum adi_cap_readout_layout readout_layout;
+};
+
+#endif
