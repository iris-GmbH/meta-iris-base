+static int adi_cap_queue_setup(struct vb2_queue *vq,
+				unsigned int *nbuffers, unsigned int *nplanes,
+				unsigned int sizes[], struct device *alloc_devs[])
+{
+	struct adi_cap_device *adi_cap_dev = vb2_get_drv_priv(vq);
+
+	v4l2_dbg(ADI_CAP_LOG_DETAIL, debug, &adi_cap_dev->v4l2_dev,
+		 "queue_setup request: buffers %u planes %u memory %s sizeimage %u\n",
+		 *nbuffers, *nplanes, adi_cap_memory_name(vq->memory),
+		 adi_cap_dev->fmt.sizeimage);
+
+	if (vq->num_buffers + *nbuffers < 2)
+		*nbuffers = 2;
+
+	if (*nplanes) {
+		if (sizes[0] < adi_cap_dev->fmt.sizeimage) {
+			v4l2_err(&adi_cap_dev->v4l2_dev,
+				 "queue_setup rejected: plane size %u < sizeimage %u\n",
+				 sizes[0], adi_cap_dev->fmt.sizeimage);
+			return -EINVAL;
+		}
+
+		return 0;
+	}
+
+	*nplanes = 1;
+	sizes[0] = adi_cap_dev->fmt.sizeimage;
+
+	v4l2_dbg(ADI_CAP_LOG_DETAIL, debug, &adi_cap_dev->v4l2_dev,
+		 "queue_setup result: buffers %u planes %u plane0 %u\n",
+		 *nbuffers, *nplanes, sizes[0]);
+
+	return 0;
+}
+
+static int adi_cap_buffer_prepare(struct vb2_buffer *vb)
+{
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct adi_cap_device *adi_cap_dev = vb2_get_drv_priv(vb->vb2_queue);
+	unsigned long size = adi_cap_dev->fmt.sizeimage;
+
+	if (vb2_plane_size(vb, 0) < size) {
+		v4l2_err(&adi_cap_dev->v4l2_dev, "buffer too small (%lu < %lu)\n",
+				vb2_plane_size(vb, 0), size);
+		return -EINVAL;
+	}
+	vb2_set_plane_payload(vb, 0, size);
+
+	vbuf->field = adi_cap_dev->fmt.field;
+
+	return 0;
+}
+
+static int adi_cap_buffer_init(struct vb2_buffer *vb)
+{
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct adi_cap_buffer *buf = to_adi_cap_vb(vbuf);
+
+	INIT_LIST_HEAD(&buf->list);
+	buf->dma_desc = NULL;
+	buf->desc_dma_addr = 0;
+	buf->desc_size = 0;
+
+	return adi_cap_setup_dma_descs(vb);
+}
+
+static void adi_cap_buffer_queue(struct vb2_buffer *vb)
+{
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct adi_cap_device *adi_cap_dev = vb2_get_drv_priv(vb->vb2_queue);
+	struct adi_cap_buffer *buf = to_adi_cap_vb(vbuf);
+	struct ppi_if *ppi = adi_cap_dev->ppi;
+	unsigned long flags;
+
+	spin_lock_irqsave(&adi_cap_dev->lock, flags);
+	list_add_tail(&buf->list, &adi_cap_dev->dma_queue);
+	if (vb2_start_streaming_called(&adi_cap_dev->buffer_queue) &&
+	    !adi_cap_dev->stop && !adi_cap_dev->cur_frm &&
+	    adi_cap_take_next_buffer(adi_cap_dev)) {
+		adi_cap_update_dma_target(adi_cap_dev, adi_cap_dev->cur_frm);
+		ppi->ops->start(ppi);
+		adi_cap_log_dma_state(adi_cap_dev, "queue restart");
+	}
+	spin_unlock_irqrestore(&adi_cap_dev->lock, flags);
+}
+
+static void adi_cap_buffer_cleanup(struct vb2_buffer *vb)
+{
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct adi_cap_device *adi_cap_dev = vb2_get_drv_priv(vb->vb2_queue);
+	struct adi_cap_buffer *buf = to_adi_cap_vb(vbuf);
+	unsigned long flags;
+
+	spin_lock_irqsave(&adi_cap_dev->lock, flags);
+	if (!list_empty(&buf->list))
+		list_del_init(&buf->list);
+	spin_unlock_irqrestore(&adi_cap_dev->lock, flags);
+
+	adi_cap_free_dma_descs(vb);
+}
+
+static int adi_cap_start_streaming(struct vb2_queue *vq, unsigned int count)
+{
+	struct adi_cap_device *adi_cap_dev = vb2_get_drv_priv(vq);
+	struct ppi_if *ppi = adi_cap_dev->ppi;
+	struct adi_cap_buffer *buf, *tmp;
+	struct ppi_params params;
+	int ret;
+
+	/* set ppi params */
+	ret = adi_cap_readout_dimensions(adi_cap_dev, adi_cap_dev->fmt.width,
+					 adi_cap_dev->fmt.height,
+					 &params.width, &params.height);
+	if (ret) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+			 "invalid readout layout %u for format %ux%u\n",
+			 adi_cap_dev->cfg->readout_layout,
+			 adi_cap_dev->fmt.width, adi_cap_dev->fmt.height);
+		goto err;
+	}
+	params.bpp = adi_cap_dev->bpp;
+	params.dlen = adi_cap_dev->dlen;
+	params.ppi_control = adi_cap_dev->cfg->ppi_control;
+	params.int_mask = adi_cap_dev->cfg->int_mask;
+	if (adi_cap_dev->cfg->inputs[adi_cap_dev->cur_input].capabilities
+			& V4L2_IN_CAP_DV_TIMINGS) {
+		struct v4l2_bt_timings *bt = &adi_cap_dev->dv_timings.bt;
+
+		params.hdelay = bt->hsync + bt->hbackporch;
+		params.vdelay = bt->vsync + bt->vbackporch;
+		params.line = V4L2_DV_BT_FRAME_WIDTH(bt);
+		params.frame = V4L2_DV_BT_FRAME_HEIGHT(bt);
+	} else if (adi_cap_dev->cfg->inputs[adi_cap_dev->cur_input].capabilities
+			& V4L2_IN_CAP_STD) {
+		params.hdelay = 0;
+		params.vdelay = 0;
+		if (adi_cap_dev->std & V4L2_STD_525_60) {
+			params.line = 858;
+			params.frame = 525;
+		} else {
+			params.line = 864;
+			params.frame = 625;
+		}
+	} else {
+		params.hdelay = 0;
+		params.vdelay = 0;
+		params.line = params.width + adi_cap_dev->cfg->blank_pixels;
+		params.frame = params.height;
+	}
+	v4l2_dbg(ADI_CAP_LOG_REPORT, debug, &adi_cap_dev->v4l2_dev,
+		 "start_streaming: dma layout %u readout layout %u fmt %ux%u bpl %u size %u ppi width %u height %u line %u frame %u bpp %u dlen %u queued %u\n",
+		 adi_cap_dev->cfg->dma_layout,
+		 adi_cap_dev->cfg->readout_layout, adi_cap_dev->fmt.width,
+		 adi_cap_dev->fmt.height, adi_cap_dev->fmt.bytesperline,
+		 adi_cap_dev->fmt.sizeimage,
+		 params.width, params.height, params.line, params.frame,
+		 params.bpp, params.dlen, count);
+
+	ret = ppi->ops->set_params(ppi, &params);
+	if (ret < 0) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+				"Error in setting ppi params\n");
+		goto err;
+	}
+	adi_cap_log_dma_state(adi_cap_dev, "after set_params");
+
+	/* attach ppi DMA irq handler */
+	ret = ppi->ops->attach_irq(ppi, adi_cap_isr);
+	if (ret < 0) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+				"Error in attaching interrupt handler\n");
+		goto err;
+	}
+
+	adi_cap_dev->sequence = 0;
+	adi_cap_reset_stream_stats(adi_cap_dev);
+
+	adi_cap_dev->stop = false;
+
+	/* get the next frame from the dma queue */
+	if (!adi_cap_take_next_buffer(adi_cap_dev)) {
+		ret = -EIO;
+		goto err_detach_irq;
+	}
+	adi_cap_update_dma_target(adi_cap_dev, adi_cap_dev->cur_frm);
+	/* enable ppi */
+	ppi->ops->start(ppi);
+	adi_cap_log_dma_state(adi_cap_dev, "after ppi_start");
+
+	/* enable streamon on the sub device */
+	ret = v4l2_subdev_call(adi_cap_dev->sd, video, s_stream, 1);
+	if (ret && (ret != -ENOIOCTLCMD)) {
+		v4l2_err(&adi_cap_dev->v4l2_dev, "stream on failed in subdev\n");
+		goto err_stop_ppi;
+	}
+
+	return 0;
+
+err_stop_ppi:
+	ppi->ops->stop(ppi);
+err_detach_irq:
+	ppi->ops->detach_irq(ppi);
+	if (adi_cap_dev->cur_frm) {
+		vb2_buffer_done(&adi_cap_dev->cur_frm->vb.vb2_buf,
+				VB2_BUF_STATE_QUEUED);
+		adi_cap_dev->cur_frm = NULL;
+	}
+err:
+	list_for_each_entry_safe(buf, tmp, &adi_cap_dev->dma_queue, list) {
+		list_del_init(&buf->list);
+		vb2_buffer_done(&buf->vb.vb2_buf, VB2_BUF_STATE_QUEUED);
+	}
+
+	return ret;
+}
+
+static void adi_cap_stop_streaming(struct vb2_queue *vq)
+{
+	struct adi_cap_device *adi_cap_dev = vb2_get_drv_priv(vq);
+	struct ppi_if *ppi = adi_cap_dev->ppi;
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&adi_cap_dev->lock, flags);
+	adi_cap_dev->stop = true;
+	adi_cap_log_dma_state(adi_cap_dev, "stop before ppi_stop");
+	ppi->ops->stop(ppi);
+	adi_cap_log_dma_state(adi_cap_dev, "stop after ppi_stop");
+	spin_unlock_irqrestore(&adi_cap_dev->lock, flags);
+
+	ppi->ops->detach_irq(ppi);
+	ret = v4l2_subdev_call(adi_cap_dev->sd, video, s_stream, 0);
+	if (ret && (ret != -ENOIOCTLCMD))
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+				"stream off failed in subdev\n");
+
+	/* release all active buffers */
+	if (adi_cap_dev->cur_frm) {
+		vb2_buffer_done(&adi_cap_dev->cur_frm->vb.vb2_buf,
+				VB2_BUF_STATE_ERROR);
+		adi_cap_dev->cur_frm = NULL;
+	}
+
+	while (!list_empty(&adi_cap_dev->dma_queue)) {
+		adi_cap_dev->cur_frm = list_entry(adi_cap_dev->dma_queue.next,
+						struct adi_cap_buffer, list);
+		list_del_init(&adi_cap_dev->cur_frm->list);
+		vb2_buffer_done(&adi_cap_dev->cur_frm->vb.vb2_buf,
+				VB2_BUF_STATE_ERROR);
+	}
+	adi_cap_dev->cur_frm = NULL;
+
+	adi_cap_log_stream_stats(adi_cap_dev);
+}
+
+static const struct vb2_ops adi_cap_video_qops = {
+	.queue_setup            = adi_cap_queue_setup,
+	.buf_init               = adi_cap_buffer_init,
+	.buf_prepare            = adi_cap_buffer_prepare,
+	.buf_cleanup            = adi_cap_buffer_cleanup,
+	.buf_queue              = adi_cap_buffer_queue,
+	.wait_prepare           = vb2_ops_wait_prepare,
+	.wait_finish            = vb2_ops_wait_finish,
+	.start_streaming        = adi_cap_start_streaming,
+	.stop_streaming         = adi_cap_stop_streaming,
+};
