+static int adi_cap_g_fmt_vid_cap(struct file *file, void *priv,
+				struct v4l2_format *fmt)
+{
+	struct adi_cap_device *adi_cap_dev = video_drvdata(file);
+
+	fmt->fmt.pix = adi_cap_dev->fmt;
+	return 0;
+}
+
+static int adi_cap_s_fmt_vid_cap(struct file *file, void *priv,
+				struct v4l2_format *fmt)
+{
+	struct adi_cap_device *adi_cap_dev = video_drvdata(file);
+	struct v4l2_subdev_format format = {
+		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
+	};
+	struct adi_cap_format adi_cap_fmt;
+	struct v4l2_pix_format *pixfmt = &fmt->fmt.pix;
+	int ret;
+
+	v4l2_dbg(ADI_CAP_LOG_DETAIL, debug, &adi_cap_dev->v4l2_dev,
+		 "s_fmt request: %p4cc %ux%u field %u colorspace %u\n",
+		 &pixfmt->pixelformat, pixfmt->width, pixfmt->height,
+		 pixfmt->field, pixfmt->colorspace);
+
+	if (vb2_is_busy(&adi_cap_dev->buffer_queue)) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+			 "s_fmt rejected: vb2 queue is busy\n");
+		return -EBUSY;
+	}
+
+	/* see if format works */
+	ret = adi_cap_try_format(adi_cap_dev, pixfmt, &adi_cap_fmt);
+	if (ret < 0) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+			 "s_fmt rejected by try_fmt: %d\n", ret);
+		return ret;
+	}
+
+	v4l2_fill_mbus_format(&format.format, pixfmt, adi_cap_fmt.mbus_code);
+	ret = adi_cap_mbus_to_readout(adi_cap_dev, &format.format);
+	if (ret) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+			 "s_fmt invalid readout layout %u for %ux%u\n",
+			 adi_cap_dev->cfg->readout_layout,
+			 pixfmt->width, pixfmt->height);
+		return ret;
+	}
+	v4l2_dbg(ADI_CAP_LOG_DETAIL, debug, &adi_cap_dev->v4l2_dev,
+		 "s_fmt subdev active request: mbus 0x%08x %ux%u dlen %u bpp %u\n",
+		 format.format.code, format.format.width,
+		 format.format.height, adi_cap_fmt.dlen, adi_cap_fmt.bpp);
+	ret = v4l2_subdev_call(adi_cap_dev->sd, pad, set_fmt, NULL, &format);
+	if (ret < 0) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+			 "s_fmt subdev active set_fmt failed: %d\n", ret);
+		return ret;
+	}
+	ret = adi_cap_mbus_to_logical(adi_cap_dev, &format.format);
+	if (ret) {
+		v4l2_err(&adi_cap_dev->v4l2_dev,
+			 "s_fmt invalid logical layout %u for subdev result %ux%u\n",
+			 adi_cap_dev->cfg->readout_layout,
+			 format.format.width, format.format.height);
+		return ret;
+	}
+	v4l2_fill_pix_format(pixfmt, &format.format);
+	pixfmt->bytesperline = pixfmt->width * adi_cap_fmt.bpp / 8;
+	pixfmt->sizeimage = pixfmt->bytesperline * pixfmt->height;
+	adi_cap_dev->fmt = *pixfmt;
+	adi_cap_dev->bpp = adi_cap_fmt.bpp;
+	adi_cap_dev->dlen = adi_cap_fmt.dlen;
+	v4l2_dbg(ADI_CAP_LOG_DETAIL, debug, &adi_cap_dev->v4l2_dev,
+		 "s_fmt applied: %p4cc %ux%u bytesperline %u sizeimage %u dlen %u bpp %u\n",
+		 &adi_cap_dev->fmt.pixelformat, adi_cap_dev->fmt.width,
+		 adi_cap_dev->fmt.height, adi_cap_dev->fmt.bytesperline,
+		 adi_cap_dev->fmt.sizeimage, adi_cap_dev->dlen,
+		 adi_cap_dev->bpp);
+	return 0;
+}
