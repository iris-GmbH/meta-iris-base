+static const char *adi_cap_memory_name(enum vb2_memory memory)
+{
+	switch (memory) {
+	case VB2_MEMORY_MMAP:
+		return "MMAP";
+	case VB2_MEMORY_USERPTR:
+		return "USERPTR";
+	case VB2_MEMORY_DMABUF:
+		return "DMABUF";
+	default:
+		return "UNKNOWN";
+	}
+}
