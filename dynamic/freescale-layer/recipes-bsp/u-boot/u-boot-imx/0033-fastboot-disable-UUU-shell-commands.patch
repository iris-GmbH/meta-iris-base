From 2d7c176db83cafc181893e5526055c8abca05595 Mon Sep 17 00:00:00 2001
From: Michael Glembotzki <Michael.Glembotzki@iris-sensing.com>
Date: Fri, 30 Oct 2026 10:59:27 +0100
Subject: [PATCH 52/52] fastboot: disable UUU shell commands

UCmd and ACmd allow a Fastboot host to execute arbitrary U-Boot shell
commands. This can be used to modify bootargs or boot an image through
an unintended boot path.

Disable FASTBOOT_UUU_SUPPORT for imx8mp_irma6r2 and use the standard
Fastboot boot command to invoke bootm at the fixed Fastboot buffer
address. This bypasses fastboot_bootcmd and prevents host-controlled
environment variables from affecting the boot path.

Keep eMMC provisioning available through the existing oem partconf and
oem bootbus commands. Validate their arguments before constructing the
MMC command so Fastboot input cannot inject shell commands.
---
 boot/image-android.c             |  4 ++++
 configs/imx8mp_irma6r2_defconfig | 10 ++++++++-
 drivers/fastboot/Kconfig         |  7 ++++++
 drivers/fastboot/fb_command.c    | 37 ++++++++++++++++++++++++++++----
 drivers/fastboot/fb_common.c     | 15 ++++++++++++-
 5 files changed, 67 insertions(+), 6 deletions(-)

diff --git a/boot/image-android.c b/boot/image-android.c
index f4ffe0bce39..8016f91856b 100644
--- a/boot/image-android.c
+++ b/boot/image-android.c
@@ -308,7 +308,9 @@ static ulong android_image_get_kernel_addr(struct andr_image_data *img_data)
 static int append_androidboot_args(char *args, uint32_t *len, void *fdt_addr)
 {
 	char args_buf[512] = {0};
+#ifdef CONFIG_FSL_FASTBOOT
 	extern boot_metric metrics;
+#endif
 
 #ifdef CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG
 	struct tag_serialnr serialnr;
@@ -416,6 +418,7 @@ static int append_androidboot_args(char *args, uint32_t *len, void *fdt_addr)
 #endif
 	}
 
+#ifdef CONFIG_FSL_FASTBOOT
 	/* boot metric variables */
 	metrics.ble_1 = get_timer(0);
 	sprintf(args_buf,
@@ -423,6 +426,7 @@ static int append_androidboot_args(char *args, uint32_t *len, void *fdt_addr)
 		metrics.bll_1, metrics.ble_1, metrics.kl, metrics.kd, metrics.avb,
 		metrics.odt, metrics.sw);
 	strncat(args, args_buf, *len - strlen(args));
+#endif
 
 #if defined(CONFIG_ARCH_MX6) || defined(CONFIG_ARCH_MX7) || \
 	defined(CONFIG_ARCH_MX7ULP) || defined(CONFIG_ARCH_IMX8M)
diff --git a/configs/imx8mp_irma6r2_defconfig b/configs/imx8mp_irma6r2_defconfig
index 5b809b07cb2..8547fe63fce 100644
--- a/configs/imx8mp_irma6r2_defconfig
+++ b/configs/imx8mp_irma6r2_defconfig
@@ -98,6 +98,7 @@ CONFIG_CMD_EXT4=y
 CONFIG_CMD_EXT4_WRITE=y
 CONFIG_CMD_FAT=y
 CONFIG_CMD_FS_GENERIC=y
+CONFIG_EFI_PARTITION=y
 CONFIG_CMD_MTDPARTS=y
 CONFIG_MTDIDS_DEFAULT="nand0=gpmi-nand"
 CONFIG_MTDPARTS_SKIP_INVALID=y
@@ -123,9 +124,16 @@ CONFIG_CLK_COMPOSITE_CCF=y
 CONFIG_SPL_CLK_IMX8MP=y
 CONFIG_CLK_IMX8MP=y
 CONFIG_USB_FUNCTION_FASTBOOT=y
-CONFIG_FASTBOOT_BUF_ADDR=0x42800000
+# CONFIG_FASTBOOT_UUU_SUPPORT is not set
+CONFIG_FASTBOOT_BUF_ADDR=0x48000000
 CONFIG_FASTBOOT_BUF_SIZE=0x40000000
 CONFIG_FASTBOOT_FLASH=y
+CONFIG_FASTBOOT_FLASH_MMC=y
+CONFIG_FASTBOOT_FLASH_MMC_DEV=2
+CONFIG_FASTBOOT_CMD_OEM_PARTCONF=y
+CONFIG_FASTBOOT_CMD_OEM_BOOTBUS=y
+CONFIG_FASTBOOT_BOOTM=y
+# CONFIG_FASTBOOT_OEM_RUN is not set
 CONFIG_MXC_GPIO=y
 CONFIG_DM_PCA953X=y
 CONFIG_DM_I2C=y
diff --git a/drivers/fastboot/Kconfig b/drivers/fastboot/Kconfig
index ea383b7db95..701170ce0ca 100644
--- a/drivers/fastboot/Kconfig
+++ b/drivers/fastboot/Kconfig
@@ -76,6 +76,13 @@ config FASTBOOT_BUF_SIZE
 	  downloads. This buffer should be as large as possible for a
 	  platform. Define this to the size available RAM for fastboot.
 
+config FASTBOOT_BOOTM
+	bool "Boot fastboot downloads with bootm"
+	depends on CMD_BOOTM
+	help
+	  Boot the downloaded image with bootm at the fixed fastboot buffer
+	  address. This ignores the fastboot_bootcmd environment variable.
+
 config FASTBOOT_USB_DEV
 	int "USB controller number"
 	depends on USB_FUNCTION_FASTBOOT
diff --git a/drivers/fastboot/fb_command.c b/drivers/fastboot/fb_command.c
index f95f4e4ae15..11599fa0b48 100644
--- a/drivers/fastboot/fb_command.c
+++ b/drivers/fastboot/fb_command.c
@@ -485,14 +485,26 @@ static void __maybe_unused oem_partconf(char *cmd_parameter, char *response)
 	char cmdbuf[32];
 	const int mmc_dev = config_opt_enabled(CONFIG_FASTBOOT_FLASH_MMC,
 					       CONFIG_FASTBOOT_FLASH_MMC_DEV, -1);
+	char *endp;
+	ulong ack, boot_part;
 
 	if (!cmd_parameter) {
 		fastboot_fail("Expected command parameter", response);
 		return;
 	}
+	ack = simple_strtoul(cmd_parameter, &endp, 0);
+	if (endp == cmd_parameter || *endp != ' ' || ack > 1) {
+		fastboot_fail("Invalid partconf arguments", response);
+		return;
+	}
+	boot_part = simple_strtoul(endp + 1, &endp, 0);
+	if (*endp || boot_part > 2) {
+		fastboot_fail("Invalid partconf arguments", response);
+		return;
+	}
 
-	/* execute 'mmc partconfg' command with cmd_parameter arguments*/
-	snprintf(cmdbuf, sizeof(cmdbuf), "mmc partconf %x %s 0", mmc_dev, cmd_parameter);
+	snprintf(cmdbuf, sizeof(cmdbuf), "mmc partconf %x %lx %lx 0",
+		 mmc_dev, ack, boot_part);
 	printf("Execute: %s\n", cmdbuf);
 	if (run_command(cmdbuf, 0))
 		fastboot_fail("Cannot set oem partconf", response);
@@ -511,14 +523,31 @@ static void __maybe_unused oem_bootbus(char *cmd_parameter, char *response)
 	char cmdbuf[32];
 	const int mmc_dev = config_opt_enabled(CONFIG_FASTBOOT_FLASH_MMC,
 					       CONFIG_FASTBOOT_FLASH_MMC_DEV, -1);
+	char *endp;
+	ulong width, reset_width, mode;
 
 	if (!cmd_parameter) {
 		fastboot_fail("Expected command parameter", response);
 		return;
 	}
+	width = simple_strtoul(cmd_parameter, &endp, 0);
+	if (endp == cmd_parameter || *endp != ' ' || width > 2) {
+		fastboot_fail("Invalid bootbus arguments", response);
+		return;
+	}
+	reset_width = simple_strtoul(endp + 1, &endp, 0);
+	if (*endp != ' ' || reset_width > 2) {
+		fastboot_fail("Invalid bootbus arguments", response);
+		return;
+	}
+	mode = simple_strtoul(endp + 1, &endp, 0);
+	if (*endp || mode > 2) {
+		fastboot_fail("Invalid bootbus arguments", response);
+		return;
+	}
 
-	/* execute 'mmc bootbus' command with cmd_parameter arguments*/
-	snprintf(cmdbuf, sizeof(cmdbuf), "mmc bootbus %x %s", mmc_dev, cmd_parameter);
+	snprintf(cmdbuf, sizeof(cmdbuf), "mmc bootbus %x %lx %lx %lx",
+		 mmc_dev, width, reset_width, mode);
 	printf("Execute: %s\n", cmdbuf);
 	if (run_command(cmdbuf, 0))
 		fastboot_fail("Cannot set oem bootbus", response);
diff --git a/drivers/fastboot/fb_common.c b/drivers/fastboot/fb_common.c
index 79c8aa1649c..8619d31b330 100644
--- a/drivers/fastboot/fb_common.c
+++ b/drivers/fastboot/fb_common.c
@@ -144,12 +144,25 @@ void (*fastboot_get_progress_callback(void))(const char *)
 void fastboot_boot(void)
 {
 	char *s;
+	static char boot_addr_start[20];
+
+	if (IS_ENABLED(CONFIG_FASTBOOT_BOOTM)) {
+		static char *const bootm_args[] = {
+			"bootm", boot_addr_start, NULL
+		};
+
+		snprintf(boot_addr_start, sizeof(boot_addr_start) - 1,
+			 "0x%p", fastboot_buf_addr);
+		printf("Booting kernel at %s...\n\n\n", boot_addr_start);
+		do_bootm(NULL, 0, 2, bootm_args);
+		do_reset(NULL, 0, 0, NULL);
+		return;
+	}
 
 	s = env_get("fastboot_bootcmd");
 	if (s) {
 		run_command(s, CMD_FLAG_ENV);
 	} else if (IS_ENABLED(CONFIG_CMD_BOOTM)) {
-		static char boot_addr_start[20];
 #ifdef CONFIG_FSL_FASTBOOT
 		static char *const bootm_args[] = {
 			"boota", boot_addr_start, NULL
-- 
