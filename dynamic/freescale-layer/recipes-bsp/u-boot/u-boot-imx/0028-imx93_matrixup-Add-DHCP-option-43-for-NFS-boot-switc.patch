From 127363fbf109adc936469fed1e35b1a3be93c978 Mon Sep 17 00:00:00 2001
From: Ian Dannapel <ian.dannapel@iris-sensing.com>
Date: Thu, 16 Jul 2026 13:06:45 +0200
Subject: [PATCH] imx93_matrixup: Add DHCP option 43 for NFS boot switch

Signed-off-by: Ian Dannapel <ian.dannapel@iris-sensing.com>
---
 .../freescale/imx93_matrixup/imx93_matrixup.c | 83 +++++++++++++++++--
 configs/imx93_matrixup_defconfig              |  1 +
 include/configs/imx93_matrixup.h              |  6 +-
 3 files changed, 82 insertions(+), 8 deletions(-)

diff --git a/board/freescale/imx93_matrixup/imx93_matrixup.c b/board/freescale/imx93_matrixup/imx93_matrixup.c
index 3d2eca9aa85..d550cd30806 100644
--- a/board/freescale/imx93_matrixup/imx93_matrixup.c
+++ b/board/freescale/imx93_matrixup/imx93_matrixup.c
@@ -6,8 +6,10 @@
 #include <common.h>
 #include <env.h>
 #include <efi_loader.h>
+#include <event.h>
 #include <init.h>
 #include <miiphy.h>
+#include <net.h>
 #include <netdev.h>
 #include <asm/global_data.h>
 #include <asm/arch-imx9/ccm_regs.h>
@@ -27,6 +29,50 @@ DECLARE_GLOBAL_DATA_PTR;
 
 #define UART_PAD_CTRL	(PAD_CTL_DSE(6) | PAD_CTL_FSEL2)
 #define WDOG_PAD_CTRL	(PAD_CTL_DSE(6) | PAD_CTL_ODE | PAD_CTL_PUE | PAD_CTL_PE)
+#define DHCP_OPTION_VENDOR_SPECIFIC	43
+
+#if defined(CONFIG_BOOTP_VENDOREX)
+u8 *dhcp_vendorex_prep(u8 *option)
+{
+	/*
+	 * CONFIG_BOOTP_VENDOREX requires both hooks. Option 43 is supplied
+	 * by the server, so leave the normal parameter request list unchanged.
+	 */
+	(void)option;
+	return NULL;
+}
+
+u8 *dhcp_vendorex_proc(u8 *option)
+{
+	static const char flag[] = "NFSBOOT=1";
+	size_t flag_len = sizeof(flag) - 1;
+	size_t option_len;
+	size_t i;
+
+	if (option[0] != DHCP_OPTION_VENDOR_SPECIFIC)
+		return NULL;
+
+	option_len = option[1];
+	for (i = 0; i + flag_len <= option_len; i++) {
+		if (!memcmp(option + 2 + i, flag, flag_len)) {
+			env_set("nfs_boot_provisioning", "1");
+			break;
+		}
+	}
+
+	return option + option_len + 2;
+}
+#endif
+
+static bool provisioning_dhcp_request(void)
+{
+	int ret;
+
+	env_set("nfs_boot_provisioning", "0");
+	ret = dhcp_run(0, NULL, false);
+
+	return !ret && env_get_yesno("nfs_boot_provisioning") == 1;
+}
 
 static iomux_v3_cfg_t const uart_pads[] = {
 	MX93_PAD_UART1_RXD__LPUART1_RX | MUX_PAD_CTRL(UART_PAD_CTRL),
@@ -238,7 +284,9 @@ void board_autogenerate_bootcmd (void)
 	char altpartboot[20];
 	int upgrade_available = env_get_ulong("upgrade_available", 10, 0);
 	int ustate = env_get_ulong("ustate", 10, 0);
-	int nfs_boot = 0;
+	bool nfs_boot = false;
+	bool nfs_boot_provisioning = false;
+	bool lock_requested = false;
 	int err = 0;
 	u32 lifecycle = 0, response = 0;
 
@@ -283,11 +331,9 @@ void board_autogenerate_bootcmd (void)
 	}
 
 	if (lifecycle == LC_OEM_OPEN) {
-		// NFS Boot is only allowed in OPEN state
-		nfs_boot = env_get_ulong("nfs_boot", 10, 0);
-
 		// Close Device if requested from env: lock_device
-		if (env_get_ulong("lock_device", 10, 0)) {
+		lock_requested = env_get_ulong("lock_device", 10, 0);
+		if (lock_requested) {
 			err = ele_forward_lifecycle(8, &response);
 			if (err != 0) {
 				printf("Error in API call: forward lifecycle for state OEM CLOSED\n");
@@ -297,9 +343,20 @@ void board_autogenerate_bootcmd (void)
 			env_set_ulong("lock_device", 0);
 			env_save();
 		}
+
+		if (!lock_requested) {
+			nfs_boot = env_get_ulong("nfs_boot", 10, 0);
+			if (!nfs_boot)
+				nfs_boot_provisioning = provisioning_dhcp_request();
+		}
 	}
 
-	if (nfs_boot) {
+	if (nfs_boot_provisioning) {
+		printf("Provision NFS boot triggered\n");
+		snprintf(bootcmd, sizeof(bootcmd), "run provision_netfitboot; reset;");
+		/* if nfsboot achieves bootcount_error limit, do not switch partition */
+		snprintf(altbootcmd, sizeof(altbootcmd), "run provision_netfitboot; reset;");
+	} else if (nfs_boot) {
 		snprintf(bootcmd, sizeof(bootcmd), "run netfitboot; reset;");
 		/* if nfsboot achieves bootcount_error limit, do not switch partition */
 		snprintf(altbootcmd, sizeof(altbootcmd), "run netfitboot; reset;");
@@ -313,6 +370,19 @@ void board_autogenerate_bootcmd (void)
 	env_set("altbootcmd", altbootcmd);
 }
 
+#ifndef CONFIG_SPL_BUILD
+static int last_stage_init(void)
+{
+	/*
+	 * provision_netfitboot needs DHCP which requires the Ethernet and MDIO state initialized by initr_net().
+	 */
+	board_autogenerate_bootcmd();
+
+	return 0;
+}
+EVENT_SPY_SIMPLE(EVT_LAST_STAGE_INIT, last_stage_init);
+#endif
+
 static void board_gpio_init(void)
 {
 	struct gpio_desc desc;
@@ -379,7 +449,6 @@ int board_late_init(void)
 	env_set("board_name", "11X11_EVK");
 	env_set("board_rev", "iMX93");
 #endif
-	board_autogenerate_bootcmd();
 	return 0;
 }
 
diff --git a/configs/imx93_matrixup_defconfig b/configs/imx93_matrixup_defconfig
index 8a6f0933820..0dda000579e 100644
--- a/configs/imx93_matrixup_defconfig
+++ b/configs/imx93_matrixup_defconfig
@@ -75,6 +75,7 @@ CONFIG_CMD_OPTEE_RPMB=y
 CONFIG_CMD_POWEROFF=y
 CONFIG_CMD_USB=y
 CONFIG_CMD_USB_MASS_STORAGE=y
+CONFIG_BOOTP_VENDOREX=y
 CONFIG_CMD_SNTP=y
 CONFIG_CMD_CACHE=y
 CONFIG_CMD_CLS=y
diff --git a/include/configs/imx93_matrixup.h b/include/configs/imx93_matrixup.h
index 86fa7405eb4..582cb501e72 100644
--- a/include/configs/imx93_matrixup.h
+++ b/include/configs/imx93_matrixup.h
@@ -97,8 +97,12 @@
 	"upgrade_available=0\0" \
 	"ustate=0\0" \
 	"netfitboot=dhcp ${fit_addr} ${fit_img}; run netargs; bootm ${fit_addr}\0" \
+	"provision_netfitboot=tftp ${fit_addr} ${fit_img}; run netargs; bootm ${fit_addr}\0" \
+	"bootpretryperiod=2000\0" \
+	"netretry=no\0" \
 	"nfsroot=/srv/nfs\0" \
 	"nfs_boot=0\0" \
+	"nfs_boot_provisioning=0\0" \
 	"loadcntr=fatload mmc ${mmcdev}:${mmcpart} ${cntr_addr} ${cntr_file}\0" \
 	"auth_os=booti ${cntr_addr}\0" \
 	"boot_os=booti ${loadaddr} - ${fdt_addr_r};\0" \
@@ -159,7 +163,7 @@
 #define WDOG_BASE_ADDR          WDG3_BASE_ADDR
 
 #if defined(CONFIG_CMD_NET)
-#define PHY_ANEG_TIMEOUT 20000
+#define PHY_ANEG_TIMEOUT 5000
 #endif
 
 #ifdef CONFIG_IMX_MATTER_TRUSTY
-- 
2.43.0

